{
  "note": "Watches applied to new approaches to market, aimed at graph, analytics, intelligence and AI work — the ground Neo4j, Palantir and Quantexa compete on. A watch fires only for notices first seen after it existed, so adding one here does not replay the archive; run `python atm.py --rematch` to replay it deliberately. Every condition a watch states must hold, and a watch that states nothing matches nothing. Terms match on word boundaries with an optional trailing 's', so 'participant' catches 'participants' but 'ndia' does not fire inside 'Indian'.",
  "fields": {
    "name": "label shown on the alert",
    "any": "fires if ANY of these terms appears",
    "all": "every one of these terms must appear",
    "none": "suppresses the match if any of these appears",
    "agency": "agency name substring",
    "panel": "Yes or No — panel arrangement",
    "multi_agency": "Yes or No — open to multiple agencies",
    "multi_stage": "Yes or No"
  },
  "rejected_terms": {
    "note": "Measured against 306,542 real contract records before being left out. Do not re-add without re-testing.",
    "intelligence": "2,459 hits, nearly all the ACIC and ONI agency names",
    "criminal intelligence": "1,568 hits, all 'Australian Criminal Intelligence Commission' as the buyer",
    "kg": "kilograms, and the German 'GmbH & Co KG' company suffix",
    "ml": "millilitres, and suppliers named ML-Tech and ML Consultancy",
    "cypher": "'cypher locks repair' — physical door hardware",
    "embedding": "'embedding knowledge in policy', 'embedding links in websites'",
    "foundry": "trading names and bronze commemorative plaques",
    "targeting": "Defence targeting studies and 'health initiative targeting young people'",
    "profiling": "seabed sub-bottom profiling surveys",
    "rag": "red/amber/green status reporting",
    "mcp": "too many unrelated expansions; 'model context protocol' is watched instead",
    "graphql": "an API query language, unrelated to graph data",
